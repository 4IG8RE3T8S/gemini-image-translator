# ตัวอย่างไฟล์การตั้งค่า Environment Variables สำหรับ Backend Proxy Server
# คัดลอกไฟล์นี้เป็น .env แล้วกรอก Gemini API Key ของคุณ

# Gemini API Key (ขอได้ฟรีที่ https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# การตั้งค่าเซิร์ฟเวอร์
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEFAULT_MODEL=gemini-2.5-flash

# Secret Token หลักสำหรับระบบ Auth
AUTH_SECRET_KEY=gemini-translator-secret-token-2026

# รหัสผ่านสำหรับบัญชีผู้ใช้เริ่มต้น
ADMIN_PASSWORD=admin123
DEMO_PASSWORD=demo123
USER_PASSWORD=user123
