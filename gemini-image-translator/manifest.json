{
  "manifest_version": 3,
  "name": "Gemini Image Translator",
  "version": "1.0.0",
  "description": "แปลข้อความในรูปภาพบนเว็บไซต์ด้วย AI — รองรับทุกภาษา รวมถึงภาษาไทย ญี่ปุ่น จีน เกาหลี | Translate text in images on any website using Google Gemini AI",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options.html"
}
